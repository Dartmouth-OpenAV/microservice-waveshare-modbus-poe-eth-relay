		{
			"name": "SET Timed Trigger",
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "http://{{microserviceURL}}/{{deviceFQDN}}/timedtrigger/{{relayNumber1}}/{{relayNumber2}}",
					"protocol": "http",
					"host": [
						"{{microserviceURL}}"
					],
					"path": [
						"{{deviceFQDN}}",
						"timedtrigger",
						"{{relayNumber1}}",
						"{{relayNumber2}}"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "\"15\""
				},
				"description": "Triggers relayNumber1 for 1 second, waits until the number of seconds in the body (1 to 30) has passed, then triggers relayNumber1 and relayNumber2 together for 1 second.\n\nAn example use case for this endpoint is to bring a projector screen down for a specified number of seconds and then stop it (most screen controllers treat up + down together as stop)."
			},
			"response": [
