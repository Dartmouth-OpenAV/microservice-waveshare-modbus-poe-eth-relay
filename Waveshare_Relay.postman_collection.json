		{
			"name": "SET Trigger",
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "http://{{microserviceURL}}/{{deviceFQDN}}/trigger/{{relayNumber}}",
					"protocol": "http",
					"host": [
						"{{microserviceURL}}"
					],
					"path": [
						"{{deviceFQDN}}",
						"trigger",
						"{{relayNumber}}"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "\"1\""
				},
				"description": "Momentarily closes a relay: sets it \"on\" for the number of seconds in the body and then back to \"off\". The seconds can be a decimal between 0.1 and 5. The pulse is timed by the device itself, so the relay opens on time even if the network drops."
			},
