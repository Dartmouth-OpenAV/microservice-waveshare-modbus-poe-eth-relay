				"header": [],
				"url": {
					"raw": "http://{{microserviceURL}}/{{deviceFQDN}}/state/{{relayNumber}}",
					"protocol": "http",
					"host": [
						"{{microserviceURL}}"
					],
					"path": [
						"{{deviceFQDN}}",
						"state",
						"{{relayNumber}}"
					]
				},
				"description": "Returns \"on\" or \"off\" for one relay. Relays are numbered from 1 up to the number of channels on the device (8 on the 8 channel version)."
			},
